{
  "name": "lb-worker-js",
  "version": "0.1.2",
  "description": "Load Balancer Worker for drive-collector",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env WRANGLER_MODE=local npm run build && cross-env WRANGLER_SEND_METRICS=false WRANGLER_SKIP_UPDATE_CHECK=true WRANGLER_OFFLINE=true wrangler dev --local --ip 127.0.0.1",
    "dev:remote": "cross-env WRANGLER_MODE=remote npm run build && cross-env WRANGLER_SEND_METRICS=false WRANGLER_SKIP_UPDATE_CHECK=true wrangler dev --remote",
    "build": "bash scripts/build.sh && esbuild src/index.js --bundle --format=esm --outdir=dist --external:node:*",
    "deploy": "npm run build && npx wrangler deploy",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "validate:manifest": "node scripts/validate-manifest.js",
    "release": "npm test && standard-version",
    "release:patch": "npm test && standard-version --release-as patch",
    "release:minor": "npm test && standard-version --release-as minor",
    "release:major": "npm test && standard-version --release-as major",
    "release:ai": "npm test && node scripts/release-ai.js && npx standard-version --skip.changelog && node --input-type=module -e \"import { syncManifestVersion } from './scripts/release-ai.js'; syncManifestVersion()\"",
    "postrelease": "git push --follow-tags origin main"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "load-balancer"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@microlabs/otel-cf-workers": "^0.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@upstash/qstash": "^2.6.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "ajv": "^8.17.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.2",
    "jest": "^29.7.0",
    "standard-version": "^9.5.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.56.0"
  },
  "standard-version": {
    "skip": {
      "changelog": false
    },
    "types": [
      {
        "type": "feat",
        "section": "✨ Features"
      },
      {
        "type": "fix",
        "section": "🐛 Bug Fixes"
      },
      {
        "type": "perf",
        "section": "🚀 Performance"
      },
      {
        "type": "docs",
        "section": "📝 Documentation"
      },
      {
        "type": "test",
        "section": "✅ Testing"
      },
      {
        "type": "chore",
        "section": "🔧 Maintenance",
        "hidden": true
      },
      {
        "type": "refactor",
        "section": "🔧 Maintenance"
      }
    ]
  }
}
