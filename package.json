{
  "name": "drive-collector-bot",
  "version": "4.33.8",
  "description": "A modular Telegram bot for transferring files to Rclone remotes",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:go": "go test ./cmd/collector/...",
    "test:go:race": "go test -race -count=1 ./cmd/collector/...",
    "check:manifest:duplicates": "node scripts/check-json-duplicates.js manifest.json",
    "db:migrate": "node scripts/db-migrate.js",
    "db:migrate:dry": "node scripts/db-migrate.js --dry-run",
    "db:check": "node scripts/db-migrate.js --check",
    "db:status": "node scripts/db-migrate.js --status",
    "drive:smoke": "node scripts/drive-support-smoke.js",
    "media:smoke": "node scripts/media-scrape-smoke.js",
    "sync:env": "node scripts/sync-env.js"
  },
  "keywords": [
    "telegram",
    "bot",
    "rclone",
    "mega",
    "drive"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1046.0",
    "@aws-sdk/lib-storage": "^3.1046.0",
    "@axiomhq/js": "^1.3.1",
    "@flydotio/litestream": "^1.0.1",
    "@infisical/sdk": "^5.0.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.219.0",
    "@opentelemetry/instrumentation-http": "^0.219.0",
    "@opentelemetry/instrumentation-ioredis": "^0.63.0",
    "@opentelemetry/instrumentation-undici": "^0.25.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@upstash/qstash": "^2.0.0",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.5.0",
    "big-integer": "1.6.52",
    "bloom-filters": "^3.0.4",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "joi": "^18.0.2",
    "p-queue": "^8.0.1",
    "patch-package": "^8.0.1",
    "telegram": "^2.22.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.59.0",
    "@rollup/rollup-linux-x64-gnu": "^4.59.0",
    "@rollup/rollup-win32-x64-msvc": "^4.59.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.0",
    "protobufjs": "^7.5.8",
    "@protobufjs/utf8": "^1.1.1"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.16",
    "cross-env": "^7.0.3",
    "standard-version": "^9.5.0",
    "vitest": "^4.1.4",
    "yaml": "^2.7.0"
  },
  "dockerfile": {
    "litestream": true
  }
}
