{
  "name": "lb-worker-js",
  "version": "0.8.1",
  "description": "Load Balancer Worker for drive-collector",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env WRANGLER_MODE=local npm run build && cross-env WRANGLER_SEND_METRICS=false WRANGLER_SKIP_UPDATE_CHECK=true WRANGLER_OFFLINE=true wrangler dev --local --ip 127.0.0.1",
    "dev:remote": "cross-env WRANGLER_MODE=remote npm run build && cross-env WRANGLER_SEND_METRICS=false WRANGLER_SKIP_UPDATE_CHECK=true wrangler dev --remote",
    "build": "bash scripts/build.sh && node --input-type=module -e \"import { build } from 'esbuild'; import { readFileSync } from 'fs'; const pkgStr = readFileSync('./package.json', 'utf8'); const pkg = JSON.parse(pkgStr); await build({ entryPoints: ['src/index.js'], bundle: true, format: 'esm', outdir: 'dist', external: ['node:*'], define: { __VERSION__: JSON.stringify(pkg.version) } });\"",
    "deploy": "npm run build && node scripts/deploy-wrapper.js",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --testPathPattern='!(integration)'",
    "test:integration": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --testPathPattern='integration'",
    "test:fast": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --maxWorkers=50%",
    "test:optimized": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --maxWorkers=100%",
    "test:full-optimized": "cross-env NODE_OPTIONS=--max-old-space-size=8192 node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --maxWorkers=100%",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --watch",
    "validate:manifest": "node scripts/validate-manifest.js",
    "diagnose:axiom": "node scripts/diagnose-axiom-logs.js",
    "release": "npm test && standard-version",
    "release:patch": "npm test && standard-version --release-as patch",
    "release:minor": "npm test && standard-version --release-as minor",
    "release:major": "npm test && standard-version --release-as major",
    "release:ai": "npm test && node scripts/release-ai.js && npx standard-version --skip.changelog && node --input-type=module -e \"import { syncManifestVersion } from './scripts/release-ai.js'; syncManifestVersion()\"",
    "postrelease": "git push --follow-tags origin main"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "load-balancer"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^20.0.0"
  },
  "dependencies": {
    "@microlabs/otel-cf-workers": "^0.1.1",
    "@opentelemetry/api": "1.4.1",
    "@upstash/qstash": "^2.8.4",
    "pino": "^10.1.0",
    "redis-on-workers": "^0.4.1"
  },
  "devDependencies": {
    "@axiomhq/js": "^1.3.1",
    "@cloudflare/workers-types": "^4.20241205.0",
    "ajv": "^8.17.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "jest": "^29.7.0",
    "standard-version": "^9.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "wrangler": "^4.56.0",
    "yargs": "^18.0.0"
  },
  "overrides": {
    "@opentelemetry/api": "1.4.1",
    "glob": "^9.0.0"
  },
  "standard-version": {
    "skip": {
      "changelog": false
    },
    "types": [
      {
        "type": "feat",
        "section": "✨ Features"
      },
      {
        "type": "fix",
        "section": "🐛 Bug Fixes"
      },
      {
        "type": "perf",
        "section": "🚀 Performance"
      },
      {
        "type": "docs",
        "section": "📝 Documentation"
      },
      {
        "type": "test",
        "section": "✅ Testing"
      },
      {
        "type": "chore",
        "section": "🔧 Maintenance",
        "hidden": true
      },
      {
        "type": "refactor",
        "section": "🔧 Maintenance"
      }
    ]
  }
}
