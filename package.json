{
  "name": "lb-worker-js",
  "version": "0.1.0",
  "description": "Load Balancer Worker for drive-collector",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "chmod +x scripts/build.sh && ./scripts/build.sh && esbuild src/index.js --bundle --format=esm --outdir=dist",
    "deploy": "npm run build && wrangler deploy --config wrangler.build.toml",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "keywords": [
    "cloudflare",
    "worker",
    "load-balancer"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@axiomhq/js": "^1.3.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.2",
    "jest": "^29.7.0",
    "wrangler": "^3.0.0"
  }
}