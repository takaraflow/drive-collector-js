# Cloudflare Worker 环境变量模板

# 开源项目隐私安全使用说明：
# 1. 复制本文件为 .env（.env 已加入 .gitignore，不会上传隐私信息）
# 2. 填写实际敏感值（如 AXIOM_TOKEN）
# 3. 本地开发：source .env && npm run dev

# 部署到 Cloudflare Workers：
# 使用 `wrangler secret put AXIOM_TOKEN` 等命令，或 Dashboard 设置敏感变量，避免硬编码泄露隐私。

# 可选 vars (build.sh 提供默认)
WORKER_NAME=drive-collector-lb  # 默认 'drive-collector-lb'
CF_KV_NAMESPACE_ID=  # 为空时无 KV 绑定 (填 your_cf_kv_namespace_id)
KV_PREVIEW_ID=your_kv_preview_id  # 默认等于 CF_KV_NAMESPACE_ID

# Axiom 日志 (必需配置)
AXIOM_TOKEN=your_axiom_token  # 高安全级别，敏感信息
AXIOM_ORG_ID=your_axiom_org_id  # 中安全级别
AXIOM_DATASET=drive-collector  # 低安全级别，默认 'drive-collector'

# QStash Webhook 签名验证 (必需配置)
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key  # 高安全级别，敏感信息
SIGNATURE_EXPIRATION_WINDOW=900  # 签名过期窗口（秒），默认900秒（15分钟）

# Upstash Redis (可选，用于故障转移)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url  # 中安全级别
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token  # 高安全级别，敏感信息

# 运行环境
NODE_ENV=development  # 低安全级别，本地开发用 'development'，生产用 'production'