# Cloudflare Worker 环境变量模板，用于本地开发\n# 复制为 .env 并填写实际值，然后运行 `source .env` 或 `export $(cat .env | xargs)`\n\nWORKER_NAME=lb-worker-js\nCF_KV_NAMESPACE_ID=your_cf_kv_namespace_id\nKV_PREVIEW_ID=your_kv_preview_id  # 默认等于 CF_KV_NAMESPACE_ID\n\n# Axiom 日志\nAXIOM_TOKEN=your_axiom_token\nAXIOM_ORG_ID=your_axiom_org_id\nAXIOM_DATASET=your_axiom_dataset\n\n# QStash (可选)\nQSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key\n\n# Upstash Redis (可选)\nUPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url\nUPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token\n\nNODE_ENV=development