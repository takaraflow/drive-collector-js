# Cloudflare Worker 环境变量模板

# 开源项目隐私安全使用说明：
# 1. 复制本文件为 .env（.env 已加入 .gitignore，不会上传隐私信息）
# 2. 填写实际敏感值（如 AXIOM_TOKEN）
# 3. 本地开发：source .env && npm run dev

# 部署到 Cloudflare Workers：
# 使用 `wrangler secret put AXIOM_TOKEN` 等命令，或 Dashboard 设置敏感变量，避免硬编码泄露隐私。

# 可选 vars (build.sh 提供默认)
WORKER_NAME=drive-collector-lb  # 默认 'drive-collector-lb'
CF_KV_NAMESPACE_ID=  # 为空时无 KV 绑定 (填 your_cf_kv_namespace_id)
KV_PREVIEW_ID=  # 远程开发模式必须设置，用于 Cloudflare 预览环境 (填 your_kv_preview_id)
KV_STORAGE=drive-collector

# Axiom 日志 (必需配置)
AXIOM_TOKEN=your_axiom_token  # 高安全级别，敏感信息
AXIOM_ORG_ID=your_axiom_org_id  # 中安全级别
AXIOM_DATASET=drive-collector  # 低安全级别，默认 'drive-collector'

# QStash Webhook 签名验证 (必需配置)
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key  # 高安全级别，敏感信息
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key  # 高安全级别，敏感信息（用于密钥轮换，可选）
SIGNATURE_EXPIRATION_WINDOW=900  # 签名过期窗口（秒），默认900秒（15分钟）
SKIP_SIGNATURE_VERIFY=  # 仅用于测试环境，跳过签名验证（留空或设为 'true'）

# 优先级：NF Redis > CF KV > Upstash Redis
# NF Redis (优先级最高，若配置完整则作为 primary)
NF_REDIS_URL=your_nf_redis_url  # 中安全级别
NF_REDIS_TOKEN=your_nf_token  # 高安全级别，敏感信息

# Upstash Redis (可选，用于故障转移)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url  # 中安全级别
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token  # 高安全级别，敏感信息

# Redis Configuration (Standard)
REDIS_URL=  # 支持 rediss:// 协议
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_MAX_RETRIES=
REDIS_RESTART_DELAY=
NF_REDIS_HOST=
NF_REDIS_PORT=
NF_REDIS_TLS_ENABLED=
NF_REDIS_TLS_REJECT_UNAUTHORIZED=
NF_REDIS_TLS_CA=
NF_REDIS_TLS_CLIENT_CERT=
NF_REDIS_TLS_CLIENT_KEY=
NF_REDIS_SNI_SERVERNAME=

# Cloudflare R2 Configuration
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Cloudflare Cache (New Standard - Preferred over CF_KV_*)
CF_CACHE_ACCOUNT_ID=
CF_CACHE_NAMESPACE_ID=
CF_CACHE_TOKEN=

# 运行环境
NODE_ENV=development  # 低安全级别，本地开发用 'development'，生产用 'production'

# 代理配置 (用于解决中国大陆网络环境下 dev:remote 模式的 UND_ERR_CONNECT_TIMEOUT 超时问题)
# Wrangler 会尊重 HTTPS_PROXY 环境变量来连接 Cloudflare API 和预览 URL
# HTTPS_PROXY=http://127.0.0.1:7890  # 示例：Clash 默认代理端口

# Cloudflare Account ID (可选，用于远程模式)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id  # 如果需要远程功能，填入你的 Cloudflare Account ID

# Deploy 专用 (CI/CD)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token  # SECRET | Deploy Only | GHA Secrets (Wrangler 部署认证)

# OSS Worker
OSS_WORKER_URL=
OSS_WORKER_SECRET=