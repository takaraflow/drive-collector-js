# 环境变量配置模板
# 复制此文件为 .env.local 进行本地开发覆盖
# 或者在 Infisical 中配置这些变量

# --- Cloudflare 配置 ---
# Cloudflare API Token (用于部署)
# CLOUDFLARE_API_TOKEN="your_api_token_here"

# Cloudflare Account ID
# CLOUDFLARE_ACCOUNT_ID="your_account_id_here"

# KV 命名空间 ID
# CF_KV_NAMESPACE_ID="your_kv_namespace_id"
# KV_PREVIEW_ID="your_kv_preview_id"

# --- 业务逻辑配置 ---
# Worker 名称 (默认使用 package.json 中的 name)
# WORKER_NAME="lb-worker"

# API 端点
# API_ENDPOINT="https://api.example.com"

# QStash 配置
# QSTASH_CURRENT_SIGNING_KEY="your_qstash_key"
# QSTASH_NEXT_SIGNING_KEY="your_qstash_next_key"

# Upstash Redis 配置
# UPSTASH_REDIS_REST_URL="https://your-redis-url"
# UPSTASH_REDIS_REST_TOKEN="your_redis_token"

# --- NF Redis 配置 (优先级最高) ---
# NF Redis URL (支持 rediss:// 协议启用 TLS)
# NF_REDIS_URL="rediss://your-redis-host:6379"
# NF_REDIS_PASSWORD="your_redis_password"

# --- 通用 TLS 配置 (适用于所有 Redis 连接) ---
# 是否拒绝未授权的 TLS 证书 (默认: true)
# REDIS_TLS_REJECT_UNAUTHORIZED="true"
# 自定义 CA 证书 (PEM 格式)
# REDIS_TLS_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# 别名: REDIS_TLS_CA_CERT
# REDIS_TLS_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# 客户端证书 (双向认证)
# REDIS_TLS_CLIENT_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# 客户端私钥 (双向认证)
# REDIS_TLS_CLIENT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# SNI 服务器名称 (如果需要自定义)
# REDIS_TLS_SNI_SERVERNAME="custom-server-name"

# Axiom 配置
# AXIOM_TOKEN="your_axiom_token"
# AXIOM_ORG_ID="your_axiom_org_id"
# AXIOM_DATASET="your_axiom_dataset"

# --- 其他配置 ---
# 签名过期窗口 (秒)
# SIGNATURE_EXPIRATION_WINDOW="900"

# 节点环境
# NODE_ENV="production"