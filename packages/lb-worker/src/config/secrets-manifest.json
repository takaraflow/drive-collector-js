{
  "manifest_version": "1.0",
  "name": "LB Worker Secrets Manifest",
  "description": "Service configuration mappings for load balancer worker secrets management",
  "version": "1.0.0",
  "services": {
    "cache": {
      "name": "Cache Service",
      "description": "Multi-provider cache management (Redis/KV)",
      "icon": "🗄️",
      "configKeys": [
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "CF_CACHE_ACCOUNT_ID",
        "CF_CACHE_TOKEN",
        "CF_CACHE_NAMESPACE_ID",
        "CACHE_PROVIDERS"
      ],
      "reinitStrategy": "reconnect",
      "healthCheck": "ping",
      "timeout": 10000,
      "dependencies": ["instanceManager"]
    },
    "qstash": {
      "name": "QStash Service",
      "description": "Webhook signature verification",
      "icon": "📬",
      "configKeys": [
        "QSTASH_CURRENT_SIGNING_KEY",
        "QSTASH_NEXT_SIGNING_KEY"
      ],
      "reinitStrategy": "reconfigure",
      "healthCheck": "verify",
      "timeout": 5000,
      "dependencies": []
    },
    "logger": {
      "name": "Logger Service",
      "description": "Structured logging with Axiom integration",
      "icon": "📝",
      "configKeys": [
        "AXIOM_TOKEN",
        "AXIOM_DATASET",
        "AXIOM_ORG_ID",
        "DEBUG_LOGS"
      ],
      "reinitStrategy": "reconfigure",
      "healthCheck": "ping",
      "timeout": 5000,
      "dependencies": []
    },
    "instanceManager": {
      "name": "Instance Manager",
      "description": "Load balancer instance discovery and management",
      "icon": "⚖️",
      "configKeys": [
        "SIGNATURE_EXPIRATION_WINDOW",
        "SKIP_SIGNATURE_VERIFY"
      ],
      "reinitStrategy": "reconnect",
      "healthCheck": "ping",
      "timeout": 8000,
      "dependencies": ["cache"]
    },
    "healthCheck": {
      "name": "Health Check Service",
      "description": "Load balancer health monitoring",
      "icon": "💊",
      "configKeys": [],
      "reinitStrategy": "reconfigure",
      "healthCheck": "ping",
      "timeout": 3000,
      "dependencies": []
    },
    "proxy": {
      "name": "Proxy Service",
      "description": "HTTP request forwarding and proxying",
      "icon": "🔄",
      "configKeys": [],
      "reinitStrategy": "reconfigure",
      "healthCheck": "ping",
      "timeout": 15000,
      "dependencies": ["instanceManager", "qstash"]
    }
  },
  "reinitStrategies": {
    "destroy_initialize": {
      "description": "Full destroy and recreate cycle",
      "steps": ["cleanup", "initialize"],
      "gracefulShutdown": true
    },
    "lightweight_reconnect": {
      "description": "Reconnect without full restart",
      "steps": ["pause", "reconnect", "resume"],
      "gracefulShutdown": false
    },
    "reconfigure": {
      "description": "Update configuration only",
      "steps": ["updateConfig"],
      "gracefulShutdown": false
    },
    "reconnect": {
      "description": "Reestablish connections",
      "steps": ["disconnect", "connect"],
      "gracefulShutdown": true
    },
    "restart": {
      "description": "Full service restart",
      "steps": ["stop", "start"],
      "gracefulShutdown": true
    }
  },
  "secretCategories": {
    "authentication": {
      "name": "Authentication",
      "description": "Tokens and API keys for service authentication",
      "priority": "high",
      "secrets": [
        "QSTASH_CURRENT_SIGNING_KEY",
        "QSTASH_NEXT_SIGNING_KEY",
        "UPSTASH_REDIS_REST_TOKEN",
        "CF_CACHE_TOKEN",
        "AXIOM_TOKEN",
        "AXIOM_ORG_ID"
      ]
    },
    "infrastructure": {
      "name": "Infrastructure",
      "description": "Infrastructure endpoints and identifiers",
      "priority": "high",
      "secrets": [
        "UPSTASH_REDIS_REST_URL",
        "CF_CACHE_ACCOUNT_ID",
        "CF_CACHE_NAMESPACE_ID",
        "AXIOM_DATASET"
      ]
    },
    "configuration": {
      "name": "Configuration",
      "description": "Service configuration and behavior settings",
      "priority": "medium",
      "secrets": [
        "SIGNATURE_EXPIRATION_WINDOW",
        "SKIP_SIGNATURE_VERIFY",
        "DEBUG_LOGS",
        "CACHE_PROVIDERS"
      ]
    }
  },
  "environments": {
    "dev": {
      "description": "Development environment",
      "overrides": {
        "DEBUG_LOGS": "true",
        "SKIP_SIGNATURE_VERIFY": "false"
      },
      "requiredSecrets": [
        "QSTASH_CURRENT_SIGNING_KEY"
      ]
    },
    "pre": {
      "description": "Pre-production environment",
      "overrides": {
        "DEBUG_LOGS": "false",
        "SKIP_SIGNATURE_VERIFY": "false"
      },
      "requiredSecrets": [
        "QSTASH_CURRENT_SIGNING_KEY",
        "QSTASH_NEXT_SIGNING_KEY",
        "AXIOM_TOKEN",
        "AXIOM_DATASET"
      ]
    },
    "prod": {
      "description": "Production environment",
      "overrides": {
        "DEBUG_LOGS": "false",
        "SKIP_SIGNATURE_VERIFY": "false"
      },
      "requiredSecrets": [
        "QSTASH_CURRENT_SIGNING_KEY",
        "QSTASH_NEXT_SIGNING_KEY",
        "AXIOM_TOKEN",
        "AXIOM_DATASET",
        "AXIOM_ORG_ID"
      ]
    }
  },
  "buildTime": {
    "description": "Build-time secrets injection configuration",
    "outputFormat": "wrangler-secrets",
    "generateMetadata": true,
    "targetFiles": [
      "secrets.json",
      ".env.build"
    ],
    "cleanupAfterBuild": true,
    "validation": {
      "requireAllRequired": true,
      "validateFormats": true,
      "checkDuplicates": true
    }
  },
  "runtime": {
    "description": "Runtime secrets management configuration",
    "polling": {
      "enabled": false,
      "interval": 30000,
      "onConfigChange": "reinit-affected-services"
    },
    "caching": {
      "enabled": true,
      "ttl": 300,
      "strategy": "memory-first"
    },
    "fallback": {
      "useEnvironmentVars": true,
      "useStaticSecrets": true
    }
  },
  "notifications": {
    "onSecretFetch": {
      "enabled": true,
      "channels": ["console"]
    },
    "onSecretChange": {
      "enabled": true,
      "channels": ["console", "logger"]
    },
    "onError": {
      "enabled": true,
      "channels": ["console", "logger"]
    },
    "channels": {
      "console": {
        "enabled": true,
        "format": "emoji"
      },
      "logger": {
        "enabled": true,
        "level": "info"
      }
    }
  },
  "validation": {
    "secretKeys": {
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "maxLength": 100,
      "minLength": 3
    },
    "secretValues": {
      "maxLength": 10000,
      "allowEmpty": false,
      "encoding": "utf8"
    },
    "requiredForEnv": {
      "prod": ["QSTASH_CURRENT_SIGNING_KEY", "AXIOM_TOKEN"],
      "pre": ["QSTASH_CURRENT_SIGNING_KEY"],
      "dev": []
    }
  },
  "security": {
    "protection": {
      "preventOverride": [
        "NODE_ENV",
        "INFISICAL_TOKEN",
        "INFISICAL_PROJECT_ID",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ]
    },
    "masking": {
      "patterns": [
        ".*TOKEN.*",
        ".*KEY.*",
        ".*SECRET.*",
        ".*PASSWORD.*"
      ],
      "maskChar": "*",
      "showLast": 4
    },
    "encryption": {
      "atRest": true,
      "inTransit": true,
      "algorithm": "AES-256-GCM"
    }
  }
}