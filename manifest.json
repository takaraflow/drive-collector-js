{
  "manifest_version": "1.1",
  "id": "lb-worker-js",
  "name": "QStash Load Balancer",
  "version": "0.8.0",
  "description": "专为 drive-collector-js 设计的高可用负载均衡器，支持 QStash 签名验证、动态实例发现与多层级故障转移。",
  "type": "worker",
  "capabilities": [
    "load-balancing",
    "dynamic-failover",
    "signature-verification",
    "instance-discovery",
    "distributed-state-management",
    "multi-instance-locking",
    "qstash-signature-v2",
    "distributed-task-scheduling",
    "path-normalization"
  ],
  "behaviors": {
    "webhookForwarder": {
      "description": "接收并验证 QStash Webhook，根据轮询策略转发至活跃实例",
      "input": "qstash-webhook",
      "inputSchema": {
        "type": "object",
        "description": "接收任何有效的 QStash 负载并透传"
      },
      "forwarding": {
        "strategy": "round-robin",
        "targetHeader": "X-Load-Balancer",
        "retryPolicy": "sequential-on-5xx"
      },
      "security": {
        "mechanism": "qstash-signature-v2",
        "headers": [
          "Upstash-Signature",
          "Upstash-Timestamp"
        ]
      },
      "dependencies": [
        "QStashService",
        "InstanceProvider"
      ],
      "reliability": {
        "timeout": 300,
        "failover": "next-available-instance",
        "retryPolicy": "exponential-backoff",
        "maxRetries": 3
      }
    },
    "instanceDiscovery": {
      "description": "从存储后端发现活跃的 drive-collector-js 实例",
      "storage": {
        "primary": "Cloudflare KV",
        "secondary": "Upstash Redis",
        "prefix": "instance:",
        "heartbeatThreshold": 900000
      },
      "locking": {
        "mechanism": "cache-atomic",
        "key": "lb:round_robin_index",
        "description": "基于分布式缓存的并发控制，确保轮询索引的一致性",
        "conflictResolution": "last-write-wins-with-version-check"
      }
    },
    "healthChecker": {
      "description": "提供 LB 运行状态检查",
      "endpoints": {
        "check": "/health"
      }
    }
  },
  "instanceRegistration": {
    "mechanism": "Distributed Cache (Redis/KV/Upstash)",
    "heartbeatInterval": 300,
    "timeout": 900,
    "keys": [
      {
        "pattern": "instance:{instanceId}",
        "description": "实例元数据"
      },
      {
        "pattern": "lock:{lockKey}",
        "description": "分布式锁键"
      },
      {
        "pattern": "task:{taskId}",
        "description": "任务键"
      },
      {
        "pattern": "msg_lock:{msgId}",
        "description": "消息锁键"
      },
      {
        "pattern": "lb:round_robin_index",
        "description": "全局轮询索引"
      }
    ],
    "leaderElection": {
      "mechanism": "cache-atomic",
      "key": "lb:leader",
      "ttl": 300,
      "description": "负载均衡器领导者选举机制，用于协调多实例操作"
    },
    "locking": {
      "mechanism": "cache-atomic",
      "operations": {
        "acquire": "get-skip-cache-then-set-with-ttl",
        "release": "delete",
        "renew": "update-ttl"
      },
      "conflictResolution": "last-write-wins-with-version-check",
      "description": "基于分布式缓存的锁实现，用于轮询索引的并发控制"
    },
    "valueSchema": {
      "instance": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "startedAt": {
            "type": "number"
          },
          "lastHeartbeat": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "offline"
            ]
          }
        },
        "required": [
          "id",
          "url",
          "hostname",
          "startedAt",
          "lastHeartbeat",
          "status"
        ]
      },
      "lock": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string"
          },
          "timestamp": {
            "type": "number"
          },
          "ttl": {
            "type": "number"
          },
          "version": {
            "type": "number"
          }
        },
        "required": [
          "owner",
          "timestamp",
          "ttl",
          "version"
        ]
      }
    },
    "reliability": {
      "cleanupInterval": 60,
      "maxLockHoldTime": 1800,
      "lockRenewalThreshold": 0.7,
      "failoverStrategy": "immediate-reacquire-on-timeout"
    }
  },
  "entrypoint": "src/index.js",
  "runtime": {
    "type": "nodejs",
    "version": "nodejs20"
  },
  "config": {
    "env": {
      "KV_STORAGE": {
        "type": "kv-namespace",
        "required": true,
        "description": "用于存储实例信息和轮询索引的 Cloudflare KV 命名空间"
      },
      "QSTASH_CURRENT_SIGNING_KEY": {
        "type": "string",
        "required": true,
        "description": "QStash 签名验证密钥"
      },
      "QSTASH_NEXT_SIGNING_KEY": {
        "type": "string",
        "required": false,
        "description": "QStash 下一个签名验证密钥（用于密钥轮换）"
      },
      "UPSTASH_REDIS_REST_URL": {
        "type": "string",
        "required": false,
        "description": "Upstash Redis API 地址，用于 KV 故障转移"
      },
      "UPSTASH_REDIS_REST_TOKEN": {
        "type": "string",
        "required": false,
        "description": "Upstash Redis 访问令牌"
      },
      "AXIOM_TOKEN": {
        "type": "string",
        "required": false,
        "description": "Axiom 日志令牌"
      },
      "AXIOM_DATASET": {
        "type": "string",
        "required": false,
        "description": "Axiom 数据集名称"
      },
      "AXIOM_ORG_ID": {
        "type": "string",
        "required": false,
        "description": "Axiom 组织 ID"
      },
      "SIGNATURE_EXPIRATION_WINDOW": {
        "type": "string",
        "required": false,
        "description": "签名过期窗口（秒），默认 900 秒（15 分钟）"
      },
      "SKIP_SIGNATURE_VERIFY": {
        "type": "string",
        "required": false,
        "description": "跳过签名验证（仅用于测试环境）"
      },
      "NODE_ENV": {
        "type": "string",
        "required": false,
        "description": "运行环境（production/development）"
      },
      "CACHE_PROVIDER": {
        "type": "string",
        "required": false,
        "description": "缓存提供者（cloudflare/upstash/nf-redis），自动检测"
      },
      "CF_CACHE_ACCOUNT_ID": {
        "type": "string",
        "required": false,
        "description": "Cloudflare Cache 账户 ID"
      },
      "CF_CACHE_TOKEN": {
        "type": "string",
        "required": false,
        "description": "Cloudflare Cache API 令牌"
      },
      "CF_CACHE_NAMESPACE_ID": {
        "type": "string",
        "required": false,
        "description": "Cloudflare Cache API 命名空间 ID"
      },
      "NF_REDIS_URL": {
        "type": "string",
        "required": false,
        "priority": "highest",
        "description": "Northflank Redis URL (redis://host:port 或 rediss://host:port, 支持 TCP+TLS)"
      },
      "NF_REDIS_PASSWORD": {
        "type": "string",
        "required": false,
        "priority": "highest",
        "description": "Northflank Redis Password（优先级最高，与 URL 配合使用）"
      },
      "REDIS_TLS_ENABLED": {
        "type": "boolean",
        "required": false,
        "description": "启用 Redis TLS 连接"
      },
      "REDIS_TLS_REJECT_UNAUTHORIZED": {
        "type": "boolean",
        "required": false,
        "description": "是否拒绝未授权的 TLS 证书"
      },
      "REDIS_TLS_CA": {
        "type": "string",
        "required": false,
        "description": "自定义 Redis TLS CA 证书"
      },
      "REDIS_TLS": {
        "type": "string",
        "required": false,
        "description": "Redis TLS 配置（向后兼容）"
      },
      "R2_ENDPOINT": {
        "type": "string",
        "required": false,
        "description": "R2 endpoint URL"
      },
      "R2_ACCESS_KEY_ID": {
        "type": "string",
        "required": false,
        "description": "R2 access key ID"
      },
      "R2_SECRET_ACCESS_KEY": {
        "type": "string",
        "required": false,
        "description": "R2 secret access key"
      },
      "R2_BUCKET": {
        "type": "string",
        "required": false,
        "description": "R2 bucket name"
      },
      "R2_PUBLIC_URL": {
        "type": "string",
        "required": false,
        "description": "R2 public URL"
      },
      "NF_REDIS_HOST": {
        "type": "string",
        "required": false,
        "description": "Northflank Redis host"
      },
      "NF_REDIS_PORT": {
        "type": "number",
        "required": false,
        "default": 6379,
        "description": "Northflank Redis port"
      },
      "NF_REDIS_TLS_ENABLED": {
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "Enable TLS for Northflank Redis"
      },
      "NF_REDIS_TLS_REJECT_UNAUTHORIZED": {
        "type": "boolean",
        "required": false,
        "default": true,
        "description": "Reject unauthorized TLS certificates for Northflank Redis"
      },
      "NF_REDIS_TLS_CA": {
        "type": "string",
        "required": false,
        "description": "Northflank Redis TLS CA certificate"
      },
      "NF_REDIS_TLS_CLIENT_CERT": {
        "type": "string",
        "required": false,
        "description": "Northflank Redis TLS client certificate"
      },
      "NF_REDIS_TLS_CLIENT_KEY": {
        "type": "string",
        "required": false,
        "description": "Northflank Redis TLS client key"
      },
      "NF_REDIS_SNI_SERVERNAME": {
        "type": "string",
        "required": false,
        "description": "Northflank Redis TLS SNI servername"
      },
      "REDIS_HOST": {
        "type": "string",
        "required": false,
        "description": "Legacy Redis host"
      },
      "REDIS_PORT": {
        "type": "number",
        "required": false,
        "default": 6379,
        "description": "Legacy Redis port"
      },
      "REDIS_MAX_RETRIES": {
        "type": "number",
        "required": false,
        "default": 5,
        "description": "Legacy Redis max retries"
      },
      "REDIS_RESTART_DELAY": {
        "type": "number",
        "required": false,
        "default": 5000,
        "description": "Legacy Redis restart delay"
      },
      "OSS_WORKER_URL": {
        "type": "string",
        "required": false,
        "description": "OSS worker URL"
      },
      "OSS_WORKER_SECRET": {
        "type": "string",
        "required": false,
        "description": "OSS worker secret"
      }
    }
  },
  "endpoints": {
    "health": "/health",
    "webhook": "/"
  },
  "infrastructure": {
    "CLOUDFLARE_ACCOUNT_ID": {
      "type": "string",
      "required": true,
      "description": "Cloudflare 账户 ID"
    },
    "WORKER_NAME": {
      "type": "string",
      "required": true,
      "description": "Worker 名称"
    },
    "CF_KV_NAMESPACE_ID": {
      "type": "string",
      "required": true,
      "description": "Cloudflare KV 命名空间 ID"
    },
    "KV_PREVIEW_ID": {
      "type": "string",
      "required": false,
      "description": "预览环境的 KV 命名空间 ID"
    }
  }
}
