# --- Go 边缘节点构建 ---
#
# 独立于 Node 镜像:边缘节点只做 webhook 接收与转发,不需要 rclone /
# s6-overlay / Node 运行时。两者并行运行,由 LB 按路径分流。
#
#   /api/v2/tasks/*  →  Go 边缘节点(本镜像)
#   其余全部        →  Node 主服务(现有镜像)
FROM golang:1.25-alpine AS build

WORKDIR /src

# 先只拷 go.mod/go.sum,让依赖层能被缓存复用 —— 改代码时不必重下依赖。
COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ ./cmd/

# CGO_ENABLED=0 出静态二进制,才能跑在 alpine 上。
# -trimpath 去掉构建机路径,-s -w 去符号表,二进制从 15M 降到 ~11M。
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath -ldflags="-s -w" \
    -o /out/collector ./cmd/collector

# --- 运行环境 ---
FROM alpine:3.20

# rclone:和 Node 镜像用同一条安装命令(rclone.org/install.sh),
# 版本天然一致,而且不依赖任何外部镜像 —— 试过 COPY --from=Node 镜像,
# 但那个仓库是私有的,CI 里会 unauthorized。
#
# 不用 Git LFS:rclone 每个平台 ~25-30MB,arm64+amd64 就 60MB。
# LFS 对象跟着分支走,升级后旧版本还一直留在仓库里,而这只是个
# 构建期依赖 —— 从官方源拉更合适。
#
# 刻意【不 pin 版本】:Node 镜像也是拉最新版,pin 了反而两边不一致。
# 要锁版本应该两边一起锁,不是只锁一边。
# 装完立刻删 zip:它在 /tmp,留着会让镜像白白大 30MB。
# bash + unzip 是 rclone.org/install.sh 自己的依赖:
#   - 脚本是 bash 的,Alpine 默认只有 sh(sh: bash: not found → 退出码 127)
#   - 它下载 zip 后要解压
# 两者 Node 镜像(基于 Debian)都有,Alpine 要显式装。
#
# 装完删掉 curl/unzip/bash 的包索引,但保留 bash —— 运行时用不到,
# 只是删了能少几 MB;真正必须留的是 rclone 本体和 ca-certificates。
RUN apk add --no-cache ca-certificates curl unzip bash fuse \
    && curl -fsSL https://rclone.org/install.sh | bash \
    && rclone version | head -1 \
    && rm -rf /tmp/rclone*

# 不以 root 运行。
RUN adduser -D -u 10001 collector

COPY --from=build /out/collector /usr/local/bin/collector

USER collector

# 与 Node 的 7860 错开:同机并行时两个服务都起得来。
EXPOSE 7861

ENV PORT=7861

ENTRYPOINT ["/usr/local/bin/collector"]
